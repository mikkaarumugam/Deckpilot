<?xml version='1.0' encoding='utf-8'?>
<!--
DeckPilot — MIDI mapping for Mixxx.

Source of truth for Mixxx-side bindings. Mixxx loads this from its
controllers/ folder; we keep a copy here in the repo so the mapping is
version-controlled and reproducible.

To install on a fresh Mac:
    DEST="$HOME/Library/Containers/org.mixxx.mixxx/Data/Library/Application Support/Mixxx/controllers"
    cp deckpilot/adapters/mappings/mixxx.midi.xml "$DEST/DeckPilot.midi.xml"
    cp deckpilot/adapters/mappings/mixxx.midi.js  "$DEST/DeckPilot.midi.js"
then load "DeckPilot" in Mixxx → Preferences → Controllers → IAC Driver Bus 1.

MIDI conventions used here:
  - status 0x90 = note_on, channel 1
  - status 0xB0 = control_change (CC), channel 1
  - midino is the value in hex (e.g. 0x3C = 60 = middle C)

Note numbers map to Python-side action handlers in deckpilot/adapters/midi.py.
Keep both files in sync — if you change a note here, change it there too.

Binding modes:
  - <normal/>         — Mixxx scales 0..127 to control value 0..1 (or
                        triggers if it's a one-shot control).
  - <script-binding/> — Calls a JS handler in DeckPilot.midi.js. Used for
                        play/pause because MIDI "velocity 0" gets dropped
                        as note_off before <normal/> sees it.
-->
<MixxxControllerPreset schemaVersion="1" mixxxVersion="2.3.0+">
    <info>
        <name>DeckPilot</name>
        <author>Mikka Arumugam</author>
        <description>Natural-language DJ control via virtual MIDI (IAC Driver).</description>
    </info>
    <controller id="IAC Driver Bus 1">
        <scriptfiles>
            <file functionprefix="DeckPilot" filename="DeckPilot.midi.js"/>
        </scriptfiles>
        <controls>

            <!-- =================================================================== -->
            <!-- Play / Pause (via JS so each intent has its own note) -->
            <!-- =================================================================== -->
            <control>
                <group>[Channel1]</group>
                <key>DeckPilot.playDeck1</key>
                <status>0x90</status><midino>0x3C</midino>
                <options><script-binding/></options>
            </control>
            <control>
                <group>[Channel1]</group>
                <key>DeckPilot.pauseDeck1</key>
                <status>0x90</status><midino>0x3D</midino>
                <options><script-binding/></options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>DeckPilot.playDeck2</key>
                <status>0x90</status><midino>0x3E</midino>
                <options><script-binding/></options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>DeckPilot.pauseDeck2</key>
                <status>0x90</status><midino>0x3F</midino>
                <options><script-binding/></options>
            </control>

            <!-- =================================================================== -->
            <!-- Crossfader (CC 20) -->
            <!-- =================================================================== -->
            <control>
                <group>[Master]</group>
                <key>crossfader</key>
                <status>0xB0</status><midino>0x14</midino>
                <options><normal/></options>
            </control>

            <!-- =================================================================== -->
            <!-- Variable loops (D-022). Each (deck, beats) gets its own toggle.
                 Toggling a different size while a loop is active replaces it
                 (Mixxx native behavior). Keep the LOOP_NOTES table in
                 adapters/midi.py in sync.

                   deck 1: 1=0x40, 2=0x41, 4=0x42, 8=0x43, 16=0x44, 32=0x45
                   deck 2: 1=0x48, 2=0x49, 4=0x4A, 8=0x4B, 16=0x4C, 32=0x4D
                 (Gap at 0x46/0x47 leaves room for future sizes.) -->
            <!-- =================================================================== -->
            <control><group>[Channel1]</group><key>beatloop_1_toggle</key>
                <status>0x90</status><midino>0x40</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>beatloop_2_toggle</key>
                <status>0x90</status><midino>0x41</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>beatloop_4_toggle</key>
                <status>0x90</status><midino>0x42</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>beatloop_8_toggle</key>
                <status>0x90</status><midino>0x43</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>beatloop_16_toggle</key>
                <status>0x90</status><midino>0x44</midino><options><normal/></options></control>
            <control><group>[Channel1]</group><key>beatloop_32_toggle</key>
                <status>0x90</status><midino>0x45</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>beatloop_1_toggle</key>
                <status>0x90</status><midino>0x48</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>beatloop_2_toggle</key>
                <status>0x90</status><midino>0x49</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>beatloop_4_toggle</key>
                <status>0x90</status><midino>0x4A</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>beatloop_8_toggle</key>
                <status>0x90</status><midino>0x4B</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>beatloop_16_toggle</key>
                <status>0x90</status><midino>0x4C</midino><options><normal/></options></control>
            <control><group>[Channel2]</group><key>beatloop_32_toggle</key>
                <status>0x90</status><midino>0x4D</midino><options><normal/></options></control>

            <!-- =================================================================== -->
            <!-- Nudge (rate_temp_up/down — hold-to-nudge button behavior) -->
            <!-- =================================================================== -->
            <control>
                <group>[Channel1]</group>
                <key>rate_temp_up</key>
                <status>0x90</status><midino>0x50</midino>
                <options><normal/></options>
            </control>
            <control>
                <group>[Channel1]</group>
                <key>rate_temp_down</key>
                <status>0x90</status><midino>0x51</midino>
                <options><normal/></options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>rate_temp_up</key>
                <status>0x90</status><midino>0x52</midino>
                <options><normal/></options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>rate_temp_down</key>
                <status>0x90</status><midino>0x53</midino>
                <options><normal/></options>
            </control>

            <!-- =================================================================== -->
            <!-- Beatsync — one-shot trigger to match BPM + beat alignment -->
            <!-- =================================================================== -->
            <control>
                <group>[Channel1]</group>
                <key>beatsync</key>
                <status>0x90</status><midino>0x5A</midino>
                <options><normal/></options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>beatsync</key>
                <status>0x90</status><midino>0x5B</midino>
                <options><normal/></options>
            </control>

            <!-- =================================================================== -->
            <!-- Hot cues — 8 per deck. Note range 100..107 (deck 1), 108..115 (deck 2). -->
            <!-- =================================================================== -->
            <control>
                <group>[Channel1]</group><key>hotcue_1_activate</key>
                <status>0x90</status><midino>0x64</midino><options><normal/></options>
            </control>
            <control>
                <group>[Channel1]</group><key>hotcue_2_activate</key>
                <status>0x90</status><midino>0x65</midino><options><normal/></options>
            </control>
            <control>
                <group>[Channel1]</group><key>hotcue_3_activate</key>
                <status>0x90</status><midino>0x66</midino><options><normal/></options>
            </control>
            <control>
                <group>[Channel1]</group><key>hotcue_4_activate</key>
                <status>0x90</status><midino>0x67</midino><options><normal/></options>
            </control>
            <control>
                <group>[Channel1]</group><key>hotcue_5_activate</key>
                <status>0x90</status><midino>0x68</midino><options><normal/></options>
            </control>
            <control>
                <group>[Channel1]</group><key>hotcue_6_activate</key>
                <status>0x90</status><midino>0x69</midino><options><normal/></options>
            </control>
            <control>
                <group>[Channel1]</group><key>hotcue_7_activate</key>
                <status>0x90</status><midino>0x6A</midino><options><normal/></options>
            </control>
            <control>
                <group>[Channel1]</group><key>hotcue_8_activate</key>
                <status>0x90</status><midino>0x6B</midino><options><normal/></options>
            </control>
            <control>
                <group>[Channel2]</group><key>hotcue_1_activate</key>
                <status>0x90</status><midino>0x6C</midino><options><normal/></options>
            </control>
            <control>
                <group>[Channel2]</group><key>hotcue_2_activate</key>
                <status>0x90</status><midino>0x6D</midino><options><normal/></options>
            </control>
            <control>
                <group>[Channel2]</group><key>hotcue_3_activate</key>
                <status>0x90</status><midino>0x6E</midino><options><normal/></options>
            </control>
            <control>
                <group>[Channel2]</group><key>hotcue_4_activate</key>
                <status>0x90</status><midino>0x6F</midino><options><normal/></options>
            </control>
            <control>
                <group>[Channel2]</group><key>hotcue_5_activate</key>
                <status>0x90</status><midino>0x70</midino><options><normal/></options>
            </control>
            <control>
                <group>[Channel2]</group><key>hotcue_6_activate</key>
                <status>0x90</status><midino>0x71</midino><options><normal/></options>
            </control>
            <control>
                <group>[Channel2]</group><key>hotcue_7_activate</key>
                <status>0x90</status><midino>0x72</midino><options><normal/></options>
            </control>
            <control>
                <group>[Channel2]</group><key>hotcue_8_activate</key>
                <status>0x90</status><midino>0x73</midino><options><normal/></options>
            </control>

            <!-- =================================================================== -->
            <!-- EQ bands per deck. The group is the EqualizerRack standard form.
                 parameter1 = low, parameter2 = mid, parameter3 = high.
                 Mixxx maps CC 0..127 to 0.0..1.0 where 0.0 = full kill, 1.0 = neutral. -->
            <!-- =================================================================== -->
            <control>
                <group>[EqualizerRack1_[Channel1]_Effect1]</group><key>parameter1</key>
                <status>0xB0</status><midino>0x1E</midino><options><normal/></options>
            </control>
            <control>
                <group>[EqualizerRack1_[Channel1]_Effect1]</group><key>parameter2</key>
                <status>0xB0</status><midino>0x1F</midino><options><normal/></options>
            </control>
            <control>
                <group>[EqualizerRack1_[Channel1]_Effect1]</group><key>parameter3</key>
                <status>0xB0</status><midino>0x20</midino><options><normal/></options>
            </control>
            <control>
                <group>[EqualizerRack1_[Channel2]_Effect1]</group><key>parameter1</key>
                <status>0xB0</status><midino>0x21</midino><options><normal/></options>
            </control>
            <control>
                <group>[EqualizerRack1_[Channel2]_Effect1]</group><key>parameter2</key>
                <status>0xB0</status><midino>0x22</midino><options><normal/></options>
            </control>
            <control>
                <group>[EqualizerRack1_[Channel2]_Effect1]</group><key>parameter3</key>
                <status>0xB0</status><midino>0x23</midino><options><normal/></options>
            </control>

            <!-- =================================================================== -->
            <!-- Channel volume (CC 40, 41) -->
            <!-- =================================================================== -->
            <control>
                <group>[Channel1]</group>
                <key>volume</key>
                <status>0xB0</status><midino>0x28</midino>
                <options><normal/></options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>volume</key>
                <status>0xB0</status><midino>0x29</midino>
                <options><normal/></options>
            </control>

            <!-- =================================================================== -->
            <!-- Filter knob per deck (D-022). One knob = LPF below center,
                 bypass at center, HPF above. QuickEffectRack super1 is
                 Mixxx's native single-knob filter; matches Pioneer-style
                 mixer ergonomics. -->
            <!-- =================================================================== -->
            <control>
                <group>[QuickEffectRack1_[Channel1]]</group>
                <key>super1</key>
                <status>0xB0</status><midino>0x24</midino>
                <options><normal/></options>
            </control>
            <control>
                <group>[QuickEffectRack1_[Channel2]]</group>
                <key>super1</key>
                <status>0xB0</status><midino>0x25</midino>
                <options><normal/></options>
            </control>

            <!-- =================================================================== -->
            <!-- Pitch slider per deck (D-022). Script-bound so the JS handler
                 can do bipolar scaling: CC 0..127 → rate -1..+1 (Mixxx's
                 default rate range is ±8% pitch). CC 64 = neutral. -->
            <!-- =================================================================== -->
            <control>
                <group>[Channel1]</group>
                <key>DeckPilot.setPitch1</key>
                <status>0xB0</status><midino>0x26</midino>
                <options><script-binding/></options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>DeckPilot.setPitch2</key>
                <status>0xB0</status><midino>0x27</midino>
                <options><script-binding/></options>
            </control>

            <!-- =================================================================== -->
            <!-- FX wet per (deck, unit) (D-022). Script-bound: the handler
                 toggles the per-deck assignment (group_[ChannelN]_enable)
                 AND sets the unit's mix knob. Mixxx's unit mix is global
                 per unit, so setting wet on both decks for the same unit
                 shares the value — documented trade-off. -->
            <!-- =================================================================== -->
            <control>
                <group>[EffectRack1_EffectUnit1]</group>
                <key>DeckPilot.setFxDeck1Unit1</key>
                <status>0xB0</status><midino>0x34</midino>
                <options><script-binding/></options>
            </control>
            <control>
                <group>[EffectRack1_EffectUnit2]</group>
                <key>DeckPilot.setFxDeck1Unit2</key>
                <status>0xB0</status><midino>0x35</midino>
                <options><script-binding/></options>
            </control>
            <control>
                <group>[EffectRack1_EffectUnit1]</group>
                <key>DeckPilot.setFxDeck2Unit1</key>
                <status>0xB0</status><midino>0x36</midino>
                <options><script-binding/></options>
            </control>
            <control>
                <group>[EffectRack1_EffectUnit2]</group>
                <key>DeckPilot.setFxDeck2Unit2</key>
                <status>0xB0</status><midino>0x37</midino>
                <options><script-binding/></options>
            </control>

            <!-- =================================================================== -->
            <!-- Request-state handshake (note 0x7F = 127).
                 Python's MixxxFeedback sends this once on startup; the JS handler
                 re-broadcasts current play state + BPM for both decks so the
                 listener gets a fresh snapshot instead of waiting for the next
                 user-driven change in Mixxx. -->
            <!-- =================================================================== -->
            <control>
                <group>[Master]</group>
                <key>DeckPilot.requestState</key>
                <status>0x90</status><midino>0x7F</midino>
                <options><script-binding/></options>
            </control>

        </controls>

        <!-- =================================================================== -->
        <!-- OUTPUTS — Mixxx → Python. Lets DeckPilot see what's happening
             without re-asking Mixxx. Listener: deckpilot/adapters/midi_feedback.py.

             Play state goes through standard <output> bindings (binary, fires
             when the watched value crosses <minimum>). Continuous controls
             (BPM, playposition) are scaled + sent from DeckPilot.midi.js via
             engine.makeConnection — see that file's init().

             Numbering keeps outputs in their own band so we can sniff the wire
             without confusion:
               - Play state notes: 0x10 (deck 1), 0x11 (deck 2)
               - BPM CCs:          0x30 (deck 1), 0x31 (deck 2)  (sent from JS)
               - Position CCs:     0x32 (deck 1), 0x33 (deck 2)  (sent from JS)
             Send-side bindings (above) start at 0x14 / 0x3C — no collision. -->
        <!-- =================================================================== -->
        <outputs>
            <output>
                <group>[Channel1]</group>
                <key>play</key>
                <status>0x90</status><midino>0x10</midino>
                <on>0x7F</on><off>0x00</off>
                <minimum>0.5</minimum>
            </output>
            <output>
                <group>[Channel2]</group>
                <key>play</key>
                <status>0x90</status><midino>0x11</midino>
                <on>0x7F</on><off>0x00</off>
                <minimum>0.5</minimum>
            </output>
        </outputs>
    </controller>
</MixxxControllerPreset>
